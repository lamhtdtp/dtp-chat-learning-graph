# Sao chép thành .env (KHÔNG commit .env). Xem specs/full-system-spec.md mục 8, 12.

# VNGCloud AI Platform (MaaS) — KHÔNG phải Google AI API trực tiếp. Gateway
# gọi mỗi model qua 1 giao thức KHÁC NHAU tuỳ model cụ thể, không suy được từ
# tên hay từ /v1/models — xem bảng _PROTOCOL_BY_MODEL trong app/llm/gateway.py
# (đã verify từng model qua API thật, không phải giả định).
AI_PLATFORM_API_KEY=
AI_PLATFORM_BASE_URL=https://maas-llm-aiplatform-hcm.api.vngcloud.vn

# LLM — 2 tầng THẬT đã hoạt động: tầng rẻ qua OpenAI SDK (chat.completions),
# tầng mạnh qua Anthropic SDK (messages) — 2 giao thức khác nhau, gateway tự
# chọn đúng cái. gemini-2.5-flash-lite (rẻ hơn flash) thử cả 2 giao thức đều
# lỗi — chưa dùng được trên key hiện tại.
GEMINI_MODEL_CHEAP=gemini/gemini-2.5-flash
GEMINI_MODEL_STRONG=gemini/gemini-2.5-pro

# Embedding — xác nhận hoạt động qua OpenAI SDK (client.embeddings.create),
# KHÔNG qua Anthropic SDK (Anthropic không có API embeddings chuẩn).
EMBEDDING_MODEL=gemini/gemini-embedding-001

# Qdrant (vector DB — nội dung SGK)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=sgk_toan

# Postgres (ma trận, taxonomy, users — KHÔNG chứa nội dung SGK)
# Dùng Postgres NATIVE có sẵn trên máy dev (Homebrew), không chạy container
# riêng — đổi user/db nếu máy bạn cấu hình khác. Đã tạo sẵn DB "chat_learning"
# bằng `createdb chat_learning`.
DATABASE_URL=postgresql+asyncpg://lamthanh@localhost:5432/chat_learning

# Redis (session/checkpoint LangGraph, semantic cache, Celery broker)
# Dùng Redis NATIVE có sẵn (Homebrew) — chọn DB index riêng (1) để không đụng
# dữ liệu của project khác đang dùng chung Redis này ở DB 0.
REDIS_URL=redis://localhost:6379/1

# Auth
JWT_SECRET=doi-thanh-chuoi-ngau-nhien-dai

# Observability — Langfuse self-host
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# CORS (frontend domain, phân tách bằng dấu phẩy nếu nhiều)
CORS_ORIGINS=http://localhost:5173
