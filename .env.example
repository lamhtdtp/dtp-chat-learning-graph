# Sao chép thành .env (KHÔNG commit .env). Xem specs/full-system-spec.md mục 8, 12.

# VNGCloud AI Platform (MaaS) — KHÔNG phải Google AI API trực tiếp. Gateway
# gọi mỗi model qua 1 giao thức KHÁC NHAU tuỳ model cụ thể, không suy được từ
# tên hay từ /v1/models — xem bảng _PROTOCOL_BY_MODEL trong app/llm/gateway.py
# (đã verify từng model qua API thật, không phải giả định).
AI_PLATFORM_API_KEY=
AI_PLATFORM_BASE_URL=https://maas-llm-aiplatform-hcm.api.vngcloud.vn

# LLM — 2 tầng, cả 2 gọi qua OpenAI SDK (chat.completions). Chọn dựa trên so
# sánh OCR thật trên trang SGK dày công thức: flash-lite nhanh gấp ~8x, rẻ ~5x,
# OCR trung thực hơn (giữ ký hiệu gốc). Tầng mạnh pro-preview cho giải bài/sinh
# đề cần lý luận nhiều bước (đốt reasoning token, nên gateway để max_tokens cao).
GEMINI_MODEL_CHEAP=google/gemma-4-31b-it
GEMINI_MODEL_STRONG=google/gemma-4-31b-it

# Embedding — gọi qua OpenAI SDK (client.embeddings.create). Dùng
# openai/text-embedding-3-large (dim 3072) vì gemini/gemini-embedding-001 đang
# bị rate-limit (429) trên VNGCloud. Đổi model KHÁC dim thì phải nạp lại Qdrant.
EMBEDDING_MODEL=openai/text-embedding-3-large

# Qdrant (vector DB — nội dung SGK)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=sgk_toan

# Postgres (ma trận, taxonomy, users — KHÔNG chứa nội dung SGK)
# Dùng Postgres NATIVE có sẵn trên host (KHÔNG chạy container). Đổi user/db cho
# khớp máy bạn; DB tạo bằng `createdb chat_learning`.
#
# DATABASE_URL: dùng cho chạy VENV (RUN.md cách A) — "localhost".
DATABASE_URL=postgresql+asyncpg://lamthanh@localhost:5432/chat_learning
# DATABASE_URL_DOCKER: dùng cho chạy DOCKER (cách B) — trong container "localhost"
# là chính container, phải trỏ host qua host.docker.internal. Compose đã có
# default này; chỉ đặt biến nếu user/db khác mặc định lamthanh/chat_learning.
# DATABASE_URL_DOCKER=postgresql+asyncpg://lamthanh@host.docker.internal:5432/chat_learning

# Redis — dùng cho: cache LLM, hạn mức hỏi/ngày, và Celery broker.
# Chỉ cần Redis THƯỜNG (get/set/incr/expire). Yêu cầu RediSearch đã mất từ khi bỏ
# checkpointer LangGraph ở P5, nên Redis native / ElastiCache / Redis LAN đều được.
#
# CHỈ đúng khi chạy app bằng venv TRÊN HOST: 6380 là cổng host map ra
# (docker-compose "6380:6379").
#
# CHẠY TRONG DOCKER thì XOÁ HẲN dòng này — compose đã có mặc định
# redis://redis:6379/0. Trong mạng compose, Redis nghe cổng 6379; đặt
# redis://redis:6380 là trộn tên service với cổng host -> "Error 111 connecting
# to redis:6380. Connection refused". Hậu quả không chỉ là video không vào hàng
# đợi: hạn mức hỏi/ngày fail-open nên tự tắt mà KHÔNG báo gì.
#
# REDIS NGOÀI (server riêng trong LAN, ElastiCache…): điền địa chỉ THẬT của nó và
# đừng khởi động service `redis` trong compose nữa. Có mật khẩu thì
# redis://:MATKHAU@host:6379/0 — thiếu mật khẩu là `.delay()` nổ giữa request.
#   REDIS_URL=redis://192.168.1.19:6379/0
REDIS_URL=redis://localhost:6380/0

# Auth — JWT_SECRET nên >=32 ký tự ngẫu nhiên (dùng: openssl rand -hex 32)
JWT_SECRET=doi-thanh-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu

# Observability — Langfuse self-host
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# CORS (frontend domain, phân tách bằng dấu phẩy nếu nhiều)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173,http://127.0.0.1:8080

# Itest (EPIC-10) — ngân hàng câu hỏi ngoài, truy cập READ-ONLY. DB nền tảng là
# MySQL (schema unit_test/question, subject='MATH', grade_id='G6'). Dùng
# credential CHỈ-ĐỌC riêng. Rỗng -> tính năng Itest TẮT (suggest chỉ chạy trên
# mirror đã đồng bộ). Cần driver pymysql: `pip install -e ".[itest]"`.
# Định dạng: mysql+pymysql://user:mat_khau@host:3306/ten_db
ITEST_DATABASE_URL=
# URL ảnh câu hỏi Itest = ITEST_CDN_BASE + question.image
ITEST_CDN_BASE=https://cdn.i-test.vn/prod/

# ── Frontend (nướng vào lúc BUILD, đổi phải build lại web/web-admin) ──────────
# URL gốc mà TRÌNH DUYỆT gọi API. Cùng domain với SPA -> để trống hoặc điền
# chính domain đó, rồi nginh trên host proxy các tiền tố API về container api
# (xem infra/nginx-dev-domain.conf.example + nginx-admin-domain.conf.example).
# Mặc định của compose là http://localhost:8000 — CHỈ đúng cho máy cá nhân;
# trên server nó khiến trình duyệt của người dùng gọi vào máy họ.
PUBLIC_API_URL=https://dev.example.com
# Domain khác cho API thì phải thêm origin của SPA vào CORS_ORIGINS ở trên.

# Subpath khi chạy CMS chung 1 domain, vd /quan-tri/. Mặc định "/" (domain riêng).
ADMIN_BASE=/
