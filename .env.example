# Sao chép thành .env (KHÔNG commit .env). Xem specs/full-system-spec.md mục 8, 12.

# Google AI (Gemini) — dùng chung cho LLM (chat/OCR/sinh đề) và embedding
GOOGLE_API_KEY=

# LLM — định tuyến 2 tầng theo task (app/llm/gateway.py)
GEMINI_MODEL_CHEAP=gemini-2.5-flash-lite
GEMINI_MODEL_STRONG=gemini-2.5-pro

# Embedding — gộp chung provider với LLM (Q4/Q12, full-system-spec.md)
EMBEDDING_MODEL=gemini-embedding-001

# Qdrant (vector DB — nội dung SGK)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=sgk_toan

# Postgres (ma trận, taxonomy, users — KHÔNG chứa nội dung SGK)
# Dùng Postgres NATIVE có sẵn trên máy dev (Homebrew), không chạy container
# riêng — đổi user/db nếu máy bạn cấu hình khác. Đã tạo sẵn DB "chat_learning"
# bằng `createdb chat_learning`.
DATABASE_URL=postgresql+asyncpg://lamthanh@localhost:5432/chat_learning

# Redis (session/checkpoint LangGraph, semantic cache, Celery broker)
# Dùng Redis NATIVE có sẵn (Homebrew) — chọn DB index riêng (1) để không đụng
# dữ liệu của project khác đang dùng chung Redis này ở DB 0.
REDIS_URL=redis://localhost:6379/1

# Auth
JWT_SECRET=doi-thanh-chuoi-ngau-nhien-dai

# Observability — Langfuse self-host
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# CORS (frontend domain, phân tách bằng dấu phẩy nếu nhiều)
CORS_ORIGINS=http://localhost:5173
