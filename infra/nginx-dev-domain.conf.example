# Nginx reverse proxy trên HOST (Ubuntu) cho server dev — 1 domain, cùng origin.
#   - các tiền tố API (xem location bên dưới)                   -> container api (127.0.0.1:8000)
#   - còn lại (SPA + asset)                                       -> container web (127.0.0.1:8080)
# Cùng origin nên KHÔNG dính CORS. WebSocket /video/ws/* được nâng cấp (Upgrade).
#
# Cài đặt:
#   sudo cp infra/nginx-dev-domain.conf.example /etc/nginx/conf.d/chat-learning.conf
#   # sửa server_name thành domain thật
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d dev.example.com        # bật HTTPS (tự chèn block 443)

# Ánh xạ header Upgrade cho WebSocket (đặt ở http context — conf.d nằm trong http{}).
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name dev.example.com;          # ⬅️ ĐỔI thành domain của bạn

    client_max_body_size 20m;

    # API + WebSocket -> container api. Khớp các tiền tố route của backend.
    #
    # DANH SÁCH NÀY PHẢI KHỚP CODE. Thiếu một tiền tố thì request rơi xuống
    # `location /` -> nginx trả index.html của SPA, client parse HTML thành JSON
    # và báo "Không gọi được máy chủ" — không có mã HTTP nào để lần.
    # Đã mất một lần với `/on-tap` (ôn tập chương + học kỳ) trên server.
    # `tests/infra/test_duong_dan_api.py` so danh sách này với router thật, thêm
    # router mà quên sửa đây là test đỏ.
    location ~ ^/(admin|auth|cms|curriculum|health|lessons|me|on-tap|progress|quiz|tutor|video)(/|$) {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # WebSocket cho /video/ws/{job_id}
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
        # Sinh đề / gọi LLM có thể lâu -> nới timeout đọc.
        proxy_read_timeout 300s;
    }

    # Web tĩnh (SPA React) -> container web (nginx nội bộ tự lo try_files/asset).
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
